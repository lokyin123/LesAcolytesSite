---
layout: base.njk
pagination:
  data: sections
  size: 1
  alias: section
permalink: "{{ section.url }}index.html"
---
{% if section.slug == "home" %}
<section class="split-hero">
  <div class="split-hero__image"><img src="{{ section.image }}" alt="{{ settings.ensemble_name }} performing together"></div>
  <div class="split-hero__panel tone-{{ section.tone }}">
    <p class="eyebrow">{{ section.eyebrow }}</p><h1>{{ settings.ensemble_name }}</h1>
    <p class="hero-summary">{{ section.summary }}</p>
    <a class="text-link" href="/about/">Discover the ensemble <span aria-hidden="true">&rarr;</span></a>
  </div>
</section>
<section class="landing-intro wrap" data-reveal>
  <p class="eyebrow">Explore</p><h2>Music, people, and performances</h2>
  <p>Follow the ensemble from the concert platform to the stories, programmes, and people behind the music.</p>
</section>
<div class="section-panels">
  {% for item in sections %}{% if item.slug != "home" %}
  <a class="section-panel{% if loop.index0 % 2 == 0 %} section-panel--reverse{% endif %}" href="{{ item.url }}" data-reveal>
    <div class="section-panel__image"><img src="{{ item.image }}" alt="" loading="lazy"></div>
    <div class="section-panel__copy tone-{{ item.tone }}">
      <p class="eyebrow">{{ item.eyebrow }}</p><h2>{{ item.title }}</h2><p>{{ item.summary }}</p>
      <span class="text-link">Explore {{ item.nav_label }} <span aria-hidden="true">&rarr;</span></span>
    </div>
  </a>
  {% endif %}{% endfor %}
</div>
{% else %}
<header class="page-hero tone-{{ section.tone }}">
  <div class="page-hero__copy"><p class="eyebrow">{{ section.eyebrow }}</p><h1>{{ section.title }}</h1><p>{{ section.summary }}</p></div>
  <img src="{{ section.image }}" alt="" class="page-hero__image">
</header>
<section class="page-content{% if section.slug == 'musicians' %} page-content--musicians{% else %} wrap{% endif %}">
  {% if section.slug == "about" %}
    <h2>About Les Acolytes</h2><div class="prose">{{ settings.about_text | safe }}</div>
  {% elif section.slug == "musicians" %}
    <div class="musician-list">
      {% for member in settings.members %}
      <article class="musician{% if loop.index0 % 2 == 1 %} musician--reverse{% endif %}">
        <div class="musician__portrait">
          {% if member.image %}
          <img src="{{ member.image }}" alt="{{ member.image_alt or member.name }}">
          {% else %}
          <div class="portrait-placeholder" aria-label="Portrait of {{ member.name }} to be added">
            <span>Portrait coming soon</span>
          </div>
          {% endif %}
        </div>
        <div class="musician__bio tone-{{ member.tone or 'sand' }}">
          <p class="eyebrow">{{ member.role }}</p>
          <h2>{{ member.name }}</h2>
          <div class="prose">{{ member.bio | safe }}</div>
        </div>
      </article>
      {% endfor %}
    </div>
  {% elif section.slug == "whats-on" %}
    <h2>Upcoming performances</h2>
    {% if collections.events.length %}<div class="event-list">{% for event in collections.events %}<article class="event-card"><p class="eyebrow">{{ event.data.event_date | eventDate }}</p><h2>{{ event.data.title }}</h2><p>{{ event.data.venue }}</p>{% if event.data.ticket_url %}<a class="text-link" href="{{ event.data.ticket_url }}">Event details <span aria-hidden="true">&rarr;</span></a>{% endif %}</article>{% endfor %}</div>{% else %}<p>New dates will be announced soon.</p>{% endif %}
  {% elif section.slug == "media" %}
    <div class="video-grid">{% for video in media.videos %}<div class="video-card"><div class="video-frame"><iframe src="https://www.youtube.com/embed/{{ video.youtube_id }}" title="{{ video.title }}" allowfullscreen></iframe></div><h2>{{ video.title }}</h2></div>{% endfor %}</div>
  {% elif section.slug == "contact" %}
    <h2>Bookings and enquiries</h2><p>{{ settings.booking_note }}</p><p><a class="text-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p><p><a class="text-link" href="{{ settings.instagram_url }}">Instagram <span aria-hidden="true">&rarr;</span></a></p>
  {% else %}
    <h2>Content coming next</h2><p>This page is now part of the site structure. Its full content and editing tools will be added in the next build stage.</p>
  {% endif %}
</section>
{% endif %}
