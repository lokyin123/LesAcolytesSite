---
layout: base.njk
pagination:
  data: sections
  size: 1
  alias: section
permalink: "{{ section.url }}index.html"
---
{% if section.slug == "home" %}
<section class="split-hero">
  <div class="split-hero__image"><img src="{{ section.image }}" alt="{{ settings.ensemble_name }} performing together"></div>
  <div class="split-hero__panel tone-{{ section.tone }}">
    <h1 class="ensemble-title" aria-label="{{ settings.ensemble_name }}"><span aria-hidden="true">les<br>Acolytes</span></h1>
    <p class="hero-summary">{{ section.summary }}</p>
    <a class="text-link" href="#find-us">Discover the ensemble <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 9 7 7 7-7"></path></svg></a>
  </div>
</section>
<section class="home-highlight" id="find-us" data-home-highlight-slider data-reveal aria-label="Homepage highlights">
  <div class="home-highlight__controls" aria-label="Homepage highlight controls">
    <button type="button" data-home-highlight-previous aria-label="Show previous highlight"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7"></path></svg></button>
    <button type="button" data-home-highlight-next aria-label="Show next highlight"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></button>
  </div>
  <div class="home-highlight__track" data-home-highlight-track tabindex="0">
    <article class="home-highlight__slide home-highlight__slide--performance">
      {% if collections.events.length %}{% set nextEvent = collections.events[0] %}
      <div class="home-highlight__state" data-home-highlight-upcoming>
        <div class="home-highlight__intro">
          <h2><a class="home-highlight__title-link" href="/whats-on/">Catch us live</a></h2>
          <p>At our next performance</p>
        </div>
        <div class="home-highlight__details">
          {% if nextEvent.data.series %}<p class="event-series">{{ nextEvent.data.series }}</p>{% endif %}
          <h3>{{ nextEvent.data.title }}</h3>
          <p class="home-highlight__date"><span>{{ nextEvent.data.event_date | eventDate }}</span>{% if nextEvent.data.event_time %}<span>{{ nextEvent.data.event_time }}</span>{% endif %}</p>
          <p class="home-highlight__venue">{{ nextEvent.data.venue }}</p>
          <a class="button-link" href="{{ nextEvent.data.ticket_url or '/whats-on/' }}"{% if nextEvent.data.ticket_url and (nextEvent.data.ticket_url | isExternalUrl) %} target="_blank" rel="noopener noreferrer"{% endif %}>View details <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </div>
      </div>
      <div class="home-highlight__state home-highlight__state--fallback" data-home-highlight-fallback hidden>
        <div class="home-highlight__intro">
          <h2>Our recent performances</h2>
        </div>
        {% if collections.pastEvents.length %}{% set latestPastEvent = collections.pastEvents[0] %}
        <div class="home-highlight__details home-highlight__details--recent">
          {% if latestPastEvent.data.series %}<p class="event-series">{{ latestPastEvent.data.series }}</p>{% endif %}
          <h3>{{ latestPastEvent.data.title }}</h3>
          <p class="home-highlight__date"><span>{{ latestPastEvent.data.event_date | eventDate }}</span></p>
          <p class="home-highlight__venue">{{ latestPastEvent.data.venue }}</p>
          <a class="button-link" href="/whats-on/#past-heading">See all performances <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </div>
        {% else %}
        <div class="home-highlight__details home-highlight__details--recent">
          <p>Discover where we have performed and revisit recent programmes.</p>
          <a class="button-link" href="/whats-on/#past-heading">Explore performances <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </div>
        {% endif %}
        <aside class="home-highlight__media-invite">
          <h3>Watch and listen in Media</h3>
          <a class="button-link" href="/media/">Explore Media <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </aside>
      </div>
      {% else %}
      <div class="home-highlight__state home-highlight__state--fallback" data-home-highlight-fallback>
        <div class="home-highlight__intro">
          <h2>Our recent performances</h2>
        </div>
        {% if collections.pastEvents.length %}{% set latestPastEvent = collections.pastEvents[0] %}
        <div class="home-highlight__details home-highlight__details--recent">
          {% if latestPastEvent.data.series %}<p class="event-series">{{ latestPastEvent.data.series }}</p>{% endif %}
          <h3>{{ latestPastEvent.data.title }}</h3>
          <p class="home-highlight__date"><span>{{ latestPastEvent.data.event_date | eventDate }}</span></p>
          <p class="home-highlight__venue">{{ latestPastEvent.data.venue }}</p>
          <a class="button-link" href="/whats-on/#past-heading">See all performances <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </div>
        {% else %}
        <div class="home-highlight__details home-highlight__details--recent">
          <p>Discover where we have performed and revisit recent programmes.</p>
          <a class="button-link" href="/whats-on/#past-heading">Explore performances <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </div>
        {% endif %}
        <aside class="home-highlight__media-invite">
          <h3>Watch and listen in Media</h3>
          <a class="button-link" href="/media/">Explore Media <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </aside>
      </div>
      {% endif %}
    </article>
    <article class="home-highlight__slide home-highlight__slide--social">
      <div class="home-highlight__intro">
        <h2>Find us on</h2>
        <p>Follow our work, recordings, and future performances.</p>
      </div>
      <div class="social-links">
        <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer"><span class="social-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" class="social-icon__fill"></circle></svg></span><span><strong>Instagram</strong><small>@lesacolytes.uk</small></span></a>
        <a href="{{ settings.facebook_url }}" target="_blank" rel="noopener noreferrer"><span class="social-icon social-icon--facebook" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 21v-8h3l.5-3H14V8.5C14 7.5 14.4 7 15.8 7H18V4.2c-.8-.1-1.7-.2-2.6-.2C12.7 4 11 5.6 11 8.6V10H8v3h3v8z" class="social-icon__fill"></path></svg></span><span><strong>Facebook</strong><small>Profile coming soon</small></span></a>
        <a href="{{ settings.continuo_url }}" target="_blank" rel="noopener noreferrer"><span class="social-icon social-icon--monogram" aria-hidden="true">CC</span><span><strong>Continuo Connect</strong><small>Artist profile coming soon</small></span></a>
        <a href="{{ settings.youtube_url }}" target="_blank" rel="noopener noreferrer"><span class="social-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 7.2a2.8 2.8 0 0 0-2-2C17.2 4.7 12 4.7 12 4.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 16.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-4.8 29 29 0 0 0-.5-4.8z" class="social-icon__fill"></path><path d="m10 15.5 5-3.5-5-3.5z" class="social-icon__paper"></path></svg></span><span><strong>YouTube</strong><small>Watch our performances</small></span></a>
      </div>
      <div class="home-highlight__contact">
        <p>Questions? Get in touch with us.</p>
        <a class="button-link" href="/contact/">Contact us <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
      </div>
    </article>
  </div>
  <div class="home-highlight__indicators" aria-label="Choose a homepage highlight">
    <button type="button" data-home-highlight-indicator="0" aria-label="Show performance highlight" aria-current="true"></button>
    <button type="button" data-home-highlight-indicator="1" aria-label="Show social links"></button>
  </div>
</section>
<div class="section-panels">
  {% for item in sections %}{% if item.slug != "home" %}
  <a class="section-panel{% if loop.index0 % 2 == 0 %} section-panel--reverse{% endif %}" href="{{ item.url }}" data-reveal>
    <div class="section-panel__image"><img src="{{ item.image }}" alt="" loading="lazy"></div>
    <div class="section-panel__copy tone-{{ item.tone }}">
      <p class="eyebrow">{{ item.eyebrow }}</p><h2>{{ item.title }}</h2><p>{{ item.summary }}</p>{% if item.slug == "contact" %}<span class="section-panel__email">{{ settings.contact_email }}</span>{% endif %}
    </div>
  </a>
  {% endif %}{% endfor %}
</div>
{% else %}
<header class="page-hero page-hero--{{ section.slug }} tone-{{ section.tone }}">
  <div class="page-hero__copy"><p class="eyebrow">{{ section.eyebrow }}</p><h1>{{ section.title }}</h1><p>{{ section.summary }}</p></div>
  <img src="{{ section.image }}" alt="" class="page-hero__image">
</header>
<section class="page-content{% if section.slug == 'musicians' %} page-content--musicians{% else %} wrap{% endif %}">
  {% if section.slug == "about" %}
    <h2>About Les Acolytes</h2><div class="prose">{{ settings.about_text | safe }}</div>
  {% elif section.slug == "musicians" %}
    <div class="musician-list">
      {% for member in settings.members %}
      <article class="musician{% if loop.index0 % 2 == 1 %} musician--reverse{% endif %}">
        <div class="musician__portrait">
          {% if member.image %}
          <img src="{{ member.image }}" alt="{{ member.image_alt or member.name }}">
          {% else %}
          <div class="portrait-placeholder" aria-label="Portrait of {{ member.name }} to be added">
            <span>Portrait coming soon</span>
          </div>
          {% endif %}
        </div>
        <div class="musician__bio tone-{{ member.tone or 'sand' }}">
          <p class="musician__role">{{ member.role }}</p>
          <h2>{{ member.name }}</h2>
          <div class="prose">{{ member.bio | safe }}</div>
        </div>
      </article>
      {% endfor %}
    </div>
  {% elif section.slug == "whats-on" %}
    <section class="upcoming-events" aria-labelledby="upcoming-heading">
      <h2 id="upcoming-heading">Upcoming performances</h2>
      {% if collections.events.length %}<div class="event-timeline">{% for event in collections.events %}
        <article class="event-feature">
          <div class="event-feature__date"><p class="event-feature__when"><span>{{ event.data.event_date | eventDate }}</span>{% if event.data.event_time %}<span>{{ event.data.event_time }}</span>{% endif %}</p></div>
          <div class="event-feature__details">{% if event.data.series %}<p class="event-series">{{ event.data.series }}</p>{% endif %}<h3>{{ event.data.title }}</h3><p class="event-feature__venue">{{ event.data.venue }}</p>{% if event.templateContent %}<div class="event-feature__description">{{ event.templateContent | safe }}</div>{% endif %}{% if event.data.ticket_url %}<a class="button-link" href="{{ event.data.ticket_url }}"{% if event.data.ticket_url | isExternalUrl %} target="_blank" rel="noopener noreferrer"{% endif %}>Event details <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>{% endif %}</div>
        </article>
      {% endfor %}</div>{% else %}<p>New dates will be announced soon.</p>{% endif %}
    </section>
    {% if collections.pastEvents.length %}{% set pastEventSlides = collections.pastEvents | eventSlides %}<section class="past-events" data-past-events-slider aria-labelledby="past-heading">
      <div class="past-events__heading"><h2 id="past-heading">Past performances</h2><div class="past-events__controls" aria-label="Past performances carousel controls"><button type="button" data-past-previous aria-label="Show previous past performances"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7"></path></svg></button><button type="button" data-past-next aria-label="Show next past performances"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></button></div></div>
      <div class="past-events__track" data-past-track tabindex="0">{% for slide in pastEventSlides %}<div class="past-events__slide past-events__slide--{% if slide.length == 1 %}2{% else %}{{ slide.length }}{% endif %}">{% for event in slide %}<article class="event-card"><p class="eyebrow">{{ event.data.event_date | eventDate }}</p>{% if event.data.series %}<p class="event-series">{{ event.data.series }}</p>{% endif %}<h3>{{ event.data.title }}</h3><p class="event-card__venue">{{ event.data.venue }}</p>{% if event.data.ticket_url %}<a class="text-link" href="{{ event.data.ticket_url }}"{% if event.data.ticket_url | isExternalUrl %} target="_blank" rel="noopener noreferrer"{% endif %}>Event details <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>{% endif %}</article>{% endfor %}{% if slide.length == 1 %}<aside class="event-card event-card--media"><p class="eyebrow">Watch &amp; listen</p><h3>Missed us live?</h3><p>Browse our videos and recordings in Media.</p><a class="text-link" href="/media/">Explore Media <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a></aside>{% endif %}</div>{% endfor %}</div>
      <div class="past-events__indicators" aria-label="Choose a past performances slide">{% for slide in pastEventSlides %}<button type="button" data-past-indicator="{{ loop.index0 }}" aria-label="Show past performances slide {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>
    </section>{% endif %}
  {% elif section.slug == "media" %}
    <section class="video-slider" data-video-slider aria-labelledby="recordings-heading">
      <div class="video-slider__heading">
        <h2 id="recordings-heading">Recordings</h2>
        <div class="video-slider__controls" aria-label="Video carousel controls">
          <button type="button" data-slider-previous aria-label="Show previous video"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7"></path></svg></button>
          <button type="button" data-slider-next aria-label="Show next video"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></button>
        </div>
      </div>
      <div class="video-track" data-slider-track tabindex="0">
        {% for video in media.videos %}<article class="video-card"><div class="video-frame"><iframe src="https://www.youtube.com/embed/{{ video.youtube_id }}" title="{{ video.composer }} — {{ video.piece }}" allowfullscreen></iframe></div><div class="video-caption"><p class="video-caption__composer">{{ video.composer }}</p><h3>{{ video.piece }}</h3></div></article>{% endfor %}
      </div>
      <div class="video-slider__indicators" aria-label="Choose a video">
        {% for video in media.videos %}<button type="button" data-slider-indicator="{{ loop.index0 }}" aria-label="Show video {{ loop.index }}: {{ video.composer }} — {{ video.piece }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}
      </div>
    </section>
    {% set photoSlides = media.photos | photoSlides %}
    <section class="media-gallery" data-gallery-slider aria-labelledby="gallery-heading">
      <div class="media-gallery__heading">
        <div><p class="eyebrow">In pictures</p><h2 id="gallery-heading">Gallery</h2></div>
        <div class="media-gallery__controls" aria-label="Gallery carousel controls">
          <button type="button" data-gallery-previous aria-label="Show previous gallery slide"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7"></path></svg></button>
          <button type="button" data-gallery-next aria-label="Show next gallery slide"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></button>
        </div>
      </div>
      <div class="media-gallery__track" data-gallery-track tabindex="0">
        {% for slide in photoSlides %}
        <div class="media-gallery__slide media-gallery__slide--{{ slide.length }}">
          {% for photo in slide %}<figure class="media-gallery__item"><button type="button" data-gallery-image data-image-src="{{ photo.src }}" data-image-alt="{{ photo.alt }}" aria-label="Expand image: {{ photo.alt }}"><img src="{{ photo.src }}" alt="{{ photo.alt }}" loading="lazy"></button></figure>{% endfor %}
        </div>
        {% endfor %}
      </div>
      <div class="media-gallery__indicators" aria-label="Choose a gallery slide">
        {% for slide in photoSlides %}<button type="button" data-gallery-indicator="{{ loop.index0 }}" aria-label="Show gallery slide {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}
      </div>
      <dialog class="gallery-lightbox" data-gallery-lightbox aria-label="Expanded gallery image">
        <button class="gallery-lightbox__close" type="button" data-gallery-close aria-label="Close expanded image"><svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"></path></svg></button>
      </dialog>
    </section>
  {% elif section.slug == "news" %}
    <div class="news-heading"><h2>Latest stories</h2><p>Updates, announcements, and notes from the ensemble.</p></div>
    {% if collections.news.length %}
    <div class="news-grid">
      {% for post in collections.news %}
      <article class="news-card" data-reveal>
        {% if post.data.image %}<a class="news-card__image" href="{{ post.url }}"><img src="{{ post.data.image }}" alt="{{ post.data.image_alt or '' }}" loading="lazy"></a>{% endif %}
        <div class="news-card__copy">
          <p class="eyebrow">{{ post.data.news_date | eventDate }}</p>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <p>{{ post.data.excerpt }}</p>
          <a class="text-link" href="{{ post.url }}">Read article <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}<p>News from the ensemble will appear here soon.</p>{% endif %}
  {% elif section.slug == "contact" %}
    <h2>Bookings and enquiries</h2>
    <p>{{ settings.booking_note }}</p>
    <p class="contact-email"><span class="copy-email-fallback" data-copy-email data-email="{{ settings.contact_email }}">{{ settings.contact_email }}</span><span class="copy-email-status" data-copy-email-status aria-live="polite"></span></p>
    <p><a class="text-link" href="{{ settings.instagram_url }}">Instagram <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a></p>
  {% else %}
    <h2>Content coming next</h2><p>This page is now part of the site structure. Its full content and editing tools will be added in the next build stage.</p>
  {% endif %}
</section>
{% endif %}
