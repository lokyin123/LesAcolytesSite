<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% elif section.slug != "home" %}{{ pages[section.slug].title }} | {% endif %}{{ settings.ensemble_name }}</title>
  <meta name="description" content="{{ excerpt or pages[section.slug].summary or settings.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500..700&family=Major+Mono+Display&family=Manrope:wght@500..700&family=Spectral:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="{{ settings.ensemble_name }}"><span aria-hidden="true">les Acolytes</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Menu</button>
    <nav class="site-nav" id="main-navigation" aria-label="Main navigation">
      <button class="menu-close" type="button">Close</button><ul>
      {% for item in sections %}{% if item.slug != "home" %}<li><a href="{{ item.url }}"{% if item.slug == section.slug %} aria-current="page"{% endif %}>{{ pages[item.slug].nav_label }}</a></li>{% endif %}{% endfor %}
    </ul></nav>
  </header>
  <main>{{ content | safe }}</main>
  <footer class="site-footer">
    <a class="brand" href="/" aria-label="{{ settings.ensemble_name }}"><span aria-hidden="true">les Acolytes</span></a>
    <div class="site-footer__end">
      <div class="footer-social-group">
        <p class="footer-social__label">{{ pages.contact.social_heading }}</p>
        <nav class="footer-social" aria-label="Social media">
        <a href="{{ pages.contact.social_links[0].url }}" target="_blank" rel="noopener noreferrer" aria-label="Les Acolytes on {{ pages.contact.social_links[0].label }}"><span class="social-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" class="social-icon__fill"></circle></svg></span></a>
        <a href="{{ pages.contact.social_links[1].url }}" target="_blank" rel="noopener noreferrer" aria-label="Les Acolytes on {{ pages.contact.social_links[1].label }}"><span class="social-icon social-icon--facebook" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 21v-8h3l.5-3H14V8.5C14 7.5 14.4 7 15.8 7H18V4.2c-.8-.1-1.7-.2-2.6-.2C12.7 4 11 5.6 11 8.6V10H8v3h3v8z" class="social-icon__fill"></path></svg></span></a>
        <a href="{{ pages.contact.social_links[2].url }}" target="_blank" rel="noopener noreferrer" aria-label="Les Acolytes on {{ pages.contact.social_links[2].label }}"><span class="social-icon social-icon--monogram" aria-hidden="true">CC</span></a>
        <a href="{{ pages.contact.social_links[3].url }}" target="_blank" rel="noopener noreferrer" aria-label="Les Acolytes on {{ pages.contact.social_links[3].label }}"><span class="social-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 7.2a2.8 2.8 0 0 0-2-2C17.2 4.7 12 4.7 12 4.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 16.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-4.8 29 29 0 0 0-.5-4.8z" class="social-icon__fill"></path><path d="m10 15.5 5-3.5-5-3.5z" class="social-icon__paper"></path></svg></span></a>
        </nav>
      </div>
      <p>&copy; {{ currentYear }} {{ settings.ensemble_name }}</p>
    </div>
  </footer>
  <script src="/js/reveal.js" defer></script>
  <script src="/js/home-highlight-slider.js" defer></script>
  <script src="/js/media-slider.js" defer></script>
  <script src="/js/gallery-slider.js" defer></script>
  <script src="/js/gallery-lightbox.js" defer></script>
  <script src="/js/past-events-slider.js" defer></script>
  <script src="/js/musician-slider.js" defer></script>
  <script src="/js/mobile-menu.js" defer></script>
  <script src="/js/copy-email.js" defer></script>
  <script>
    if (window.netlifyIdentity) window.netlifyIdentity.on("init", function (user) {
      if (!user) window.netlifyIdentity.on("login", function () { document.location.href = "/admin/"; });
    });
  </script>
  {% if isDevelopment %}{% include "dev/tweaks-panel.njk" %}{% endif %}
</body>
</html>
