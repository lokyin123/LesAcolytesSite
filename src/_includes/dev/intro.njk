<!-- First-visit homepage introduction. Included in both local and production builds. -->
<style id="la-intro-styles">
  [data-la-intro]{display:none}
  [data-la-intro].is-visible{position:fixed;inset:0;z-index:11000;display:grid;place-items:center;padding:2rem;color:var(--ink);background:var(--paper);cursor:pointer}
  [data-la-intro].is-visible::after{position:absolute;right:1.5rem;bottom:1.25rem;left:1.5rem;color:var(--muted);content:"Click, press any key, or scroll to skip";font-family:var(--interface);font-size:.7rem;letter-spacing:.1em;text-align:center;text-transform:uppercase}
  .la-intro__stage{display:flex;max-width:min(34rem,100%);align-items:center;flex-direction:column;gap:1.25rem;text-align:center;transform:translateY(-.75rem)}
  .la-intro__logo{display:block;width:min(28rem,82vw);height:auto;overflow:visible;transform:translateY(-1rem);opacity:0;will-change:transform,opacity}
  .la-intro__logo--fallback{clip-path:inset(0 100% 0 0)}
  .la-intro__welcome{margin:0;color:var(--muted);font-family:var(--interface);font-size:.82rem;font-weight:550;letter-spacing:.2em;text-transform:uppercase;opacity:0;transform:translateY(-.25rem)}
  [data-la-intro].is-playing .la-intro__logo{animation:la-intro-land .52s cubic-bezier(.16,1,.3,1) forwards}
  [data-la-intro].is-playing .la-intro__logo--fallback{animation:la-intro-fallback 1.1s cubic-bezier(.22,1,.36,1) forwards}
  [data-la-intro].is-playing .la-intro__welcome{animation:la-intro-welcome .52s cubic-bezier(.16,1,.3,1) .78s forwards}
  [data-la-intro].is-closing{pointer-events:none;animation:la-intro-close .3s ease-out forwards}
  @keyframes la-intro-land{from{opacity:0;transform:translateY(-1rem)}to{opacity:1;transform:translateY(0)}}
  @keyframes la-intro-fallback{0%{clip-path:inset(0 100% 0 0);opacity:0;transform:translateY(-1rem)}12%{opacity:1}100%{clip-path:inset(0 0 0 0);opacity:1;transform:translateY(0)}}
  @keyframes la-intro-welcome{to{opacity:1;transform:translateY(0)}}
  @keyframes la-intro-close{to{opacity:0;visibility:hidden}}
  @media(max-width:650px){[data-la-intro].is-visible{padding:1.5rem}.la-intro__logo{width:min(26rem,86vw)}[data-la-intro].is-visible::after{right:1rem;bottom:1rem;left:1rem;font-size:.64rem}}
  @media(prefers-reduced-motion:reduce){[data-la-intro].is-visible{display:none!important}}
</style>
<div data-la-intro hidden aria-label="Welcome to Les Acolytes">
  <div class="la-intro__stage">
    <img class="la-intro__logo la-intro__logo--fallback" src="/images/logo%20final%20dark%20text.svg" alt="Les Acolytes">
    <p class="la-intro__welcome">Welcome</p>
  </div>
</div>
<script>
  (function () {
    var intro = document.querySelector("[data-la-intro]");
    if (!intro) return;

    var INTRO_ENABLED = true; // Set to false to disable the local prototype.
    var seenKey = "les-acolytes-intro-seen-v1";
    var duration = 1800;
    var reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var preview = new URLSearchParams(window.location.search).has("intro");
    var seen = false;

    try { seen = window.sessionStorage.getItem(seenKey) === "1"; } catch (error) {}
    if (!INTRO_ENABLED || reducedMotion || (seen && !preview)) return;

    var finished = false;
    var timer;

    intro.hidden = false;
    intro.classList.add("is-visible", "is-loading");

    function isRed(path) {
      var fill = (path.getAttribute("fill") || "").toLowerCase();
      var stroke = (path.getAttribute("stroke") || "").toLowerCase();
      return fill === "#7f4356" || stroke === "#7f4356";
    }

    function animateLogo(svg) {
      if (!svg || !window.DOMParser) return false;
      var paths = Array.prototype.slice.call(svg.querySelectorAll("path"));
      var red = paths.filter(isRed);
      var black = paths.filter(function (path) { return !isRed(path); });
      var namespace = "http://www.w3.org/2000/svg";
      var redGroup = document.createElementNS(namespace, "g");
      var blackGroup = document.createElementNS(namespace, "g");
      redGroup.setAttribute("class", "la-intro__draw-group la-intro__draw-group--red");
      blackGroup.setAttribute("class", "la-intro__draw-group la-intro__draw-group--black");
      red.forEach(function (path) { redGroup.appendChild(path); });
      black.forEach(function (path) { blackGroup.appendChild(path); });
      svg.appendChild(redGroup);
      svg.appendChild(blackGroup);

      function reveal(group, delay, drawDuration) {
        group.style.clipPath = "inset(0 100% 0 0)";
        group.style.opacity = "0";
        group.style.willChange = "clip-path,opacity";
        if (!group.animate) {
          group.style.clipPath = "inset(0)";
          group.style.opacity = "1";
          return;
        }
        group.animate([
          { clipPath: "inset(0 100% 0 0)", opacity: 0 },
          { clipPath: "inset(0)", opacity: 1 }
        ], { duration: drawDuration, delay: delay, easing: "cubic-bezier(.16,1,.3,1)", fill: "forwards" });
      }

      reveal(redGroup, 80, 680);
      reveal(blackGroup, 800, 860);
      return true;
    }

    function start(svg) {
      if (finished) return;
      intro.classList.remove("is-loading");
      intro.classList.add("is-playing");
      animateLogo(svg);
      timer = window.setTimeout(finish, duration);
    }

    function loadLogo() {
      var fallback = intro.querySelector(".la-intro__logo--fallback");
      if (!fallback || !window.fetch || !window.DOMParser) {
        start(null);
        return;
      }
      window.fetch(fallback.src).then(function (response) {
        if (!response.ok) throw new Error("Logo could not be loaded");
        return response.text();
      }).then(function (source) {
        if (finished) return;
        var svg = new DOMParser().parseFromString(source, "image/svg+xml").documentElement;
        svg.classList.add("la-intro__logo");
        svg.setAttribute("role", "img");
        svg.setAttribute("aria-label", "Les Acolytes");
        fallback.replaceWith(svg);
        start(svg);
      }).catch(function () { start(null); });
    }

    function finish() {
      if (finished) return;
      finished = true;
      window.clearTimeout(timer);
      try { window.sessionStorage.setItem(seenKey, "1"); } catch (error) {}
      intro.classList.remove("is-playing");
      intro.classList.add("is-closing");
      window.setTimeout(function () {
        intro.hidden = true;
        intro.classList.remove("is-visible", "is-closing");
      }, 320);
      intro.removeEventListener("click", finish);
      window.removeEventListener("keydown", finish);
      window.removeEventListener("scroll", finish);
      window.removeEventListener("touchstart", finish);
    }

    intro.addEventListener("click", finish);
    window.addEventListener("keydown", finish);
    window.addEventListener("scroll", finish, { passive: true });
    window.addEventListener("touchstart", finish, { passive: true });
    loadLogo();
  }());
</script>
