---
layout: base.njk
pagination:
  data: collections.news
  size: 6
  alias: posts
permalink: "news/{% if pagination.pageNumber %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
section:
  slug: news
  title: News
  nav_label: News
  summary: "Read the latest news, project announcements, and developments from Les Acolytes."
---
<header class="page-hero page-hero--news tone-sand">
  <div class="page-hero__copy"><p class="eyebrow">From the ensemble</p><h1>News</h1><p>{{ section.summary }}</p></div>
  <img src="/images/GROUPSHOTS/Amelia-Read-Photography-86-news.jpg" alt="" class="page-hero__image">
</header>
<section class="page-content wrap">
  <div class="news-heading"><h2>Latest stories</h2><p>Updates, announcements, and notes from the ensemble.</p></div>
  {% if posts.length %}
  <div class="news-grid">
    {% for post in posts %}
    <article class="news-card" data-reveal>
      {% if post.data.image %}<a class="news-card__image" href="{{ post.url }}"><img src="{{ post.data.image }}" alt="{{ post.data.image_alt or '' }}" loading="lazy"></a>{% endif %}
      <div class="news-card__copy">
        <p class="eyebrow">{{ post.data.news_date | eventDate }}</p>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.excerpt }}</p>
        <a class="text-link" href="{{ post.url }}">Read article <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}<p>News from the ensemble will appear here soon.</p>{% endif %}
  {% if pagination.hrefs.length > 1 %}
  <nav class="news-pagination" aria-label="News pages">
    {% for href in pagination.hrefs %}<a href="{{ href }}"{% if loop.index0 == pagination.pageNumber %} aria-current="page"{% endif %}>{{ loop.index }}</a>{% endfor %}
  </nav>
  {% endif %}
</section>
