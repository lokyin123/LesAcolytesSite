---
layout: base.njk
pagination:
  data: collections.news
  size: 6
  alias: posts
permalink: "news/{% if pagination.pageNumber %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
section:
  slug: news
---
<header class="page-hero page-hero--news tone-{{ pages.news.tone }}">
  <div class="page-hero__copy"><p class="eyebrow">{{ pages.news.eyebrow }}</p><h1>{{ pages.news.title }}</h1><p>{{ pages.news.summary }}</p></div>
  <img src="{{ pages.news.image }}" alt="" class="page-hero__image">
</header>
<section class="page-content wrap">
  <div class="news-heading"><h2>{{ pages.news.listing_heading }}</h2><p>{{ pages.news.listing_intro }}</p></div>
  {% if posts.length %}
  <div class="news-grid">
    {% for post in posts %}
      <article class="news-card" data-reveal>
        {% if post.data.image %}<a class="news-card__image{% if post.data.image_tone %} news-card__image--{{ post.data.image_tone }}{% endif %}{% if post.data.image_fit %} news-card__image--{{ post.data.image_fit }}{% endif %}" href="{{ post.url }}"><img src="{{ post.data.image }}" alt="{{ post.data.image_alt or '' }}" loading="lazy"></a>{% endif %}
        <div class="news-card__copy">
          {% if post.data.pinned %}<p class="pinned-marker"><svg class="pinned-marker__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 3 6 6-4 1-4 4 1 4-2 2-2-5-5-2 2-2 5 1 4-4zM4 20l5-5"></path></svg><span>Pinned</span></p>{% endif %}
          <p class="eyebrow">{{ post.data.news_date | eventDate }}</p>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.excerpt }}</p>
        <a class="text-link" href="{{ post.url }}">Read article <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg></a>
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}<p>News from the ensemble will appear here soon.</p>{% endif %}
  {% if pagination.hrefs.length > 1 %}
  <nav class="news-pagination" aria-label="News pages">
    {% for href in pagination.hrefs %}<a href="{{ href }}"{% if loop.index0 == pagination.pageNumber %} aria-current="page"{% endif %}>{{ loop.index }}</a>{% endfor %}
  </nav>
  {% endif %}
</section>
